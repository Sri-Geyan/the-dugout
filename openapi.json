  "components": {
    "schemas": {
      "AuctionState": {
        "properties": {
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "player_features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Player Features"
          },
          "current_bid": {
            "type": "number",
            "title": "Current Bid"
          },
          "purse_remaining": {
            "type": "number",
            "title": "Purse Remaining"
          },
          "scarcity_score": {
            "type": "number",
            "title": "Scarcity Score"
          },
          "team_needs_score": {
            "type": "number",
            "title": "Team Needs Score"
          }
        },
        "type": "object",
        "required": [
          "team_id",
          "player_features",
          "current_bid",
          "purse_remaining",
          "scarcity_score",
          "team_needs_score"
        ],
        "title": "AuctionState"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchState": {
        "properties": {
          "venue": {
            "type": "string",
            "title": "Venue",
            "default": "Neutral"
          },
          "target": {
            "type": "integer",
            "title": "Target",
            "default": 0
          }
        },
        "type": "object",
        "title": "MatchState"
      },
      "RetentionState": {
        "properties": {
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "player_features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Player Features"
          }
        },
        "type": "object",
        "required": [
          "team_id",
          "player_features"
        ],
        "title": "RetentionState"
      },
      "SquadPayload": {
        "properties": {
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "players": {
            "items": {},
            "type": "array",
            "title": "Players"
          }
        },
        "type": "object",
        "required": [
          "team_id",
          "venue",
          "players"
        ],
        "title": "SquadPayload"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
